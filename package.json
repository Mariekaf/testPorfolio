{
  "name": "portfolio-saas-foundations",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/studio",
    "packages/content-contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @portfolio/studio",
