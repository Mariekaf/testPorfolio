{
  "openapi": "3.1.0",
  "info": {
    "title": "Hero Design v2 — inactive E02 proposal",
    "version": "0.1.0",
    "description": "Standalone review artifact. Not referenced by active OpenAPI/router. Existing endpoints remain v1. Upgrade endpoint intentionally deferred to E04; no endpoint implementation in E02."
  },
  "x-activation-status": "proposed-not-active",
  "security": [
    {
      "session": []
    }
  ],
