          "200": {
            "description": "Coherent private snapshot and canonical Portfolio ETag.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "no-store"
                }
              },
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Design"
                }
              }
            }
          },
          "400": {
