          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Accept-Design-Schema",
          "in": "header",
          "required": false,
          "description": "Absent = 1. Exact ordered list of supported envelopes; never performs conversion. Authorization precedes negotiation.",
