  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portfolio_saas_session"
      }
    },
    "schemas": {
      "Design": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "portfolio_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "oneOf": [
              {
                "$ref": "../../../contracts/schemas/templates/documents/snapshot.v1.json"
              },
              {
                "$ref": "../../../contracts/schemas/templates/documents/snapshot.v2.json"
              }
            ]
          }
        },
        "required": [
          "portfolio_id",
          "version",
          "etag",
          "snapshot"
        ]
      },
      "DesignUpdate": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "$ref": "../../../contracts/schemas/templates/documents/content.v1.json"
              },
              "customization": {
                "$ref": "../../../contracts/schemas/templates/documents/customization.v1.json"
              }
            },
            "required": [
              "content",
              "customization"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "$ref": "../../../contracts/schemas/templates/documents/content.v1.json"
              },
              "customization": {
                "$ref": "../../../contracts/schemas/templates/documents/customization.v2.json"
              }
            },
            "required": [
              "content",
              "customization"
            ]
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "enum": [
                  "invalid_design",
                  "invalid_request",
                  "authentication_required",
                  "csrf_failed",
                  "not_found",
                  "design_schema_not_acceptable",
                  "design_inconsistent",
                  "design_not_initialized",
                  "portfolio_archived",
                  "version_conflict",
                  "precondition_required",
                  "payload_too_large",
                  "unsupported_media_type",
                  "rate_limited",
                  "temporarily_unavailable",
                  "validation_error",
                  "request_denied"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              }
            }
          }
        }
      }
    }
