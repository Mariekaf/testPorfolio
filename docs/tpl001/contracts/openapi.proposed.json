  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portfolio_saas_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 80
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              }
            }
          }
        }
      },
      "Descriptor": {
        "$ref": "../../../contracts/schemas/templates/template.v1.json"
      },
      "Snapshot": {
        "$ref": "schemas/snapshot.v1.json"
      },
      "Customization": {
        "$ref": "schemas/customization.v1.json"
      },
      "Content": {
        "$ref": "schemas/content.v1.json"
      },
      "Portfolio": {
        "$ref": "../../../contracts/api/portfolios.v1.json#/components/schemas/Portfolio"
      },
      "CreateFromTemplate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "template_id",
          "template_version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 110
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "template_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,59}$"
          },
          "template_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      },
      "Design": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "portfolio_id",
          "version",
          "etag",
          "snapshot"
        ],
        "properties": {
          "portfolio_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "maxLength": 150
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          }
        }
      },
      "SaveDesign": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "customization"
        ],
        "properties": {
          "content": {
            "$ref": "#/components/schemas/Content"
          },
          "customization": {
            "$ref": "#/components/schemas/Customization"
          }
        }
      },
      "Catalogue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "page",
          "page_size",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "const": 12
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Descriptor"
            },
            "minItems": 0,
            "maxItems": 12
          }
        }
      }
    }
  }
}
