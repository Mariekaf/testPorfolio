            "maximum": 400
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "thumbnail_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "status": {
            "const": "ready"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "etag": {
            "type": "string"
          },
          "thumbnail_url": {
            "type": "string",
            "pattern": "^/api/v1/media/assets/[0-9a-f-]{36}/thumbnail$"
          },
          "file_url": {
            "type": "string",
            "pattern": "^/api/v1/media/assets/[0-9a-f-]{36}/file$"
          }
        },
        "required": [
          "id",
          "original_name",
          "content_type",
          "width",
          "height",
          "thumbnail_width",
          "thumbnail_height",
          "size",
          "thumbnail_size",
          "status",
          "version",
          "created_at",
          "etag",
          "thumbnail_url",
          "file_url"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object"
              }
            },
