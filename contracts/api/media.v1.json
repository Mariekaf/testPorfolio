    "/api/v1/ready-portfolios/{id}/media": {
      "post": {
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session requise ; private, no-store, Vary Cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "assets": {
                      "type": "object",
                      "additionalProperties": false,
                      "patternProperties": {
                        "^[0-9a-f-]{36}$": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "state": {
                                  "const": "missing"
                                }
                              },
                              "required": [
                                "state"
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "state": {
                                  "const": "ready"
                                },
                                "asset_id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "width": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 2560
                                },
                                "height": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 2560
                                },
                                "src": {
                                  "type": "string",
                                  "pattern": "^/api/v1/media/assets/[0-9a-f-]{36}/file$"
                                }
                              },
                              "required": [
                                "state",
                                "asset_id",
                                "width",
                                "height",
                                "src"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "assets"
                  ]
                }
              }
            }
