{
  "openapi": "3.1.0",
  "info": {
    "title": "TPL-001.B authenticated read-only templates",
    "version": "1.0.0",
    "description": "Validated Git catalogue and synthetic preview snapshots only. No instance persistence, creation, publication or design mutations."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/templates": {
      "get": {
        "operationId": "tpl_list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "minimal",
                "editorial",
                "retro",
                "cyberpunk",
                "gaming",
                "immersive"
              ]
            }
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "available",
                "unavailable",
                "retired"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success (proposed contract)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          },
          "400": {
            "description": "Invalid schema/query or missing/invalid idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          },
          "404": {
            "description": "Unknown, foreign or deleted resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          },
          "503": {
            "description": "Temporary unavailability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          },
          "405": {
            "description": "Read-only resource; write method denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          },
          "403": {
            "description": "Request denied (including CSRF on unsupported write methods).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                },
                "description": "Private response, never cached."
              }
            }
          }
        }
      }
    },
