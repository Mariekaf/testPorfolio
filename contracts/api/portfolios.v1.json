                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "List": {
        "type": "object",
        "required": [
          "count",
          "active_count",
          "archived_count",
          "page",
          "page_size",
          "results"
        ],
        "properties": {
