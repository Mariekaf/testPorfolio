      }
    },
    "schemas": {
      "Portfolio": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "account_id",
          "name",
          "slug",
          "description",
          "management_state",
          "publication_state",
          "visibility",
          "version",
          "etag",
          "source_template_id",
          "source_template_version",
          "initial_theme_id",
          "initial_theme_version",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "maxLength": 110,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "management_state": {
            "enum": [
              "active",
              "archived"
            ]
          },
          "publication_state": {
            "const": "draft"
          },
          "visibility": {
            "const": "private"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "etag": {
            "type": "string"
          },
          "source_template_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_template_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "initial_theme_id": {
            "const": "studio-neutral"
          },
          "initial_theme_version": {
            "const": "1.0.0"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "maxLength": 110,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "Patch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
