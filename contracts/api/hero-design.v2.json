      "Design": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "portfolio_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "oneOf": [
              {
                "$ref": "../schemas/templates/documents/snapshot.v1.json"
              },
              {
                "$ref": "../schemas/templates/documents/snapshot.v2.json"
              }
            ]
          }
        },
        "required": [
          "portfolio_id",
          "version",
          "etag",
          "snapshot"
        ]
      },
      "DesignUpdate": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "$ref": "../schemas/templates/documents/content.v1.json"
              },
              "customization": {
                "$ref": "../schemas/templates/documents/customization.v1.json"
              }
            },
            "required": [
              "content",
              "customization"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "$ref": "../schemas/templates/documents/content.v1.json"
              },
