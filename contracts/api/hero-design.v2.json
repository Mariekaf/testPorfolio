              }
            },
            "required": [
              "content",
              "customization"
            ]
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "enum": [
                  "invalid_design",
                  "invalid_request",
                  "authentication_required",
                  "csrf_failed",
                  "not_found",
                  "design_schema_not_acceptable",
                  "design_inconsistent",
                  "design_not_initialized",
                  "portfolio_archived",
                  "version_conflict",
                  "precondition_required",
                  "payload_too_large",
                  "unsupported_media_type",
                  "rate_limited",
                  "temporarily_unavailable",
                  "validation_error",
                  "request_denied",
                  "hero_transitions_disabled",
                  "invalid_idempotency_key",
                  "idempotency_conflict",
                  "design_already_v2",
                  "design_already_v1",
                  "recovery_inconsistent",
                  "conversion_refused"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              }
            }
          }
        }
      },
