{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline ready registry manifest v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "digest_algorithm": {
      "const": "sha256-list-v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "template": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "maxLength": 30
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "preview",
              "available",
              "deprecated",
              "retired",
              "quarantined"
            ]
          },
          "bundle_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "enum": [
                    "descriptor",
                    "snapshot",
                    "style-policy",
                    "fonts",
                    "responsive",
                    "demo-content"
                  ]
                },
                "path": {
                  "type": "string",
                  "maxLength": 200
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 262144
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "role",
                "path",
                "bytes",
                "sha256"
              ]
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "template",
          "status",
          "bundle_digest",
          "files"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "digest_algorithm",
    "entries"
  ]
}
