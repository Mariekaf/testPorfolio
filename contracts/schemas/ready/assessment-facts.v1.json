{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted offline assessment facts v1 \u2014 never client document fields",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "verified_user_project_ids": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "assets": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id",
            "state",
            "rights_confirmed"
          ],
          "properties": {
            "account_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "state": {
              "enum": [
                "processing",
                "ready",
                "rejected"
              ]
            },
            "rights_confirmed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
