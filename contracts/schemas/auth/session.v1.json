{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:auth:session:v1",
  "title": "Authenticated session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user",
    "expires_at"
  ],
  "properties": {
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "first_name",
        "last_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
