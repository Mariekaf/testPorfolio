{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future template descriptor v1 (not an executable catalogue)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "category",
    "description",
    "compatible_themes",
    "availability"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "category": {
      "enum": [
        "minimal",
        "editorial",
        "retro",
        "cyberpunk",
        "gaming",
        "immersive"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "thumbnail": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "compatible_themes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    },
    "availability": {
      "enum": [
        "unavailable",
        "available",
        "retired"
      ]
    },
    "composition_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_id"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_document_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "presentation_document_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "experience_document_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  }
}
