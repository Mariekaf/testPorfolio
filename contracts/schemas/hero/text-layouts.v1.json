{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E06 textual layout profile v1 \u2014 trusted build input only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "layouts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "text-layouts"
    },
    "version": {
      "const": "1.0.0"
    },
    "layouts": {
      "const": [
        {
          "id": "product-showcase",
          "version": "1.1.0",
          "requires": [
            "content-v1"
          ]
        },
        {
          "id": "bento-grid",
          "version": "1.1.0",
          "requires": [
            "content-v1"
          ]
        }
      ]
    }
  }
}
